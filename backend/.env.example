# ===== Banco (o MESMO Postgres do OpenDriverHub) =====
# ?schema=opendriver é obrigatório: as tabelas e o histórico de migrations do
# OpenDriver ficam no schema "opendriver"; o schema "public" é do hub.
DATABASE_URL="postgresql://usuario:senha@host-interno:5432/hub?schema=opendriver"

# ===== Autenticação compartilhada (RF11) =====
# DEVE ser idêntico ao JWT_SECRET do hub.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=604800

# ===== URLs =====
PORT=5100
PUBLIC_BASE_URL=https://api-app.opendriver.com.br
HUB_WEB_URL=https://opendriver.com.br
CORS_ORIGINS=https://opendriver.com.br

# ===== Criptografia (tokens de cartão e gravações) =====
# openssl rand -base64 32   — guarde com segurança; trocar invalida o que já foi cifrado.
DATA_ENCRYPTION_KEY=

# ===== Pagamentos =====
# mock (dev) | asaas. Credenciais Asaas vêm de Admin → Integrações do hub
# (public.integration_settings) ou das envs Asaas__ApiKey / Asaas__Environment / Asaas__WebhookToken.
PAYMENT_PROVIDER=asaas
PAYMENT_WEBHOOK_REQUIRE_TOKEN=true

# ===== Mapas (OpenStreetMap) =====
# Use instâncias próprias em produção (os servidores públicos proíbem uso comercial pesado).
OSRM_URL=https://osrm.seudominio.com.br
NOMINATIM_URL=https://nominatim.seudominio.com.br
GEO_CONTACT_EMAIL=contato@opendriver.com.br
GEO_COUNTRY_CODES=br

# ===== Matching =====
DISPATCH_OFFER_TIMEOUT_SECONDS=15
DISPATCH_SEARCH_RADIUS_KM=8
DISPATCH_MAX_OFFERS=8
DISPATCH_SEARCH_TIMEOUT_SECONDS=180

# ===== Cancelamento (plano de melhorias §1) =====
CANCEL_GRACE_SECONDS=180

# ===== Validação de CRLV (plano §4) =====
# mock (dev) | infosimples. Token real vem de public.integration_settings
# (Infosimples:Token) com fallback para esta env.
VEHICLE_VALIDATION_PROVIDER=mock
INFOSIMPLES_TOKEN=

# ===== Geocoding (plano §10) =====
# Com chave, o Google Maps é o provedor padrão (melhor cobertura); sem
# chave, usa só o Nominatim self-hosted. Nominatim sempre entra como reserva
# se o Google não encontrar nada ou estiver indisponível.
GOOGLE_MAPS_API_KEY=

# ===== Storage privado (MinIO do hub, bucket PRÓPRIO e privado) =====
MINIO_ENDPOINT=http://minio-service:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PRIVATE_BUCKET=opendriver-private

# ===== Gravação de áudio (RF16) =====
RECORDING_RETENTION_DAYS=30
RECORDING_CONSENT_VERSION=v1-2026-09

RATE_LIMIT_AUTH_PERMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ===== Páginas legais (/legal/privacidade e /legal/termos) =====
LEGAL_COMPANY=OpenDriver Tecnologia Ltda.
LEGAL_CONTACT_EMAIL=privacidade@opendriver.com.br

# Copie para terraform.tfvars (ignorado pelo git) e ajuste.
aws_region = "us-east-1"   # sa-east-1 (São Paulo): menor latência, ~35% mais cara
# instance_type  = "t3.large"   # 8 GB: API + Nominatim + OSRM (Centro-Oeste)
domain     = "api-app.opendriver.com.br"
acme_email = "voce@exemplo.com.br"

# tiles_domain          = "tiles.opendriver.com.br"
# create_storage_bucket = true   # S3 privado; false = usar o MinIO do hub

# Alertas de custo (AWS Budgets): e-mail quando o gasto passar de 50% de US$ 100.
alert_emails = ["voce@exemplo.com.br"]
# budget_limit_usd     = 100
# budget_alert_percent = 50
# budget_time_unit     = "ANNUALLY"   # ou "MONTHLY"

# cat ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... voce@pc"

# Seu IP público (curl https://checkip.amazonaws.com) — nunca 0.0.0.0/0.
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Chave dedicada para agentes de IA (opcional; só vale no primeiro boot —
# para revogar depois, remova a linha de ~/.ssh/authorized_keys na instância).
# extra_ssh_public_keys = ["ssh-ed25519 AAAA... agente-ia"]
